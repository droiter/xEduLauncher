<?xml version="1.0" encoding="utf-8"?>
<!-- 盖在孩子正用着的应用之上的一张对话框：外面压暗，中间一张卡片 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/challenge_card"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="✖️"
            android:textSize="44sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="用了一会儿啦，做道题"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="算对了接着用，算错了就要回桌面"
            android:textColor="#FFB9C7DE"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/challengeQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="7 × 8 = ?"
            android:textColor="#FFFFFFFF"
            android:textSize="40sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/challengeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:hint="答案"
            android:importantForAutofill="no"
            android:inputType="number"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#FF7C8CA6"
            android:textSize="28sp" />

        <Button
            android:id="@+id/challengeOk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="确定" />

        <TextView
            android:id="@+id/challengeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="只有一次机会"
            android:textColor="#FF7C8CA6"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
